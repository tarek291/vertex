# Canonical list of environment variables for Vertex.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.

# --- Sanity: web app (browser-safe) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional; defaults to the date pinned in sanity/env.ts
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Sanity: web app (server only) ---
# Viewer token from https://www.sanity.io/manage — reads the private dataset.
# Never prefix with NEXT_PUBLIC_. Used by sanity/lib/{live,client,api}.ts only.
SANITY_API_READ_TOKEN=

# --- Sanity: standalone Studio (studio/) ---
# Studio config reads these; it loads this file via vite envDir: '..'.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- Sanity Context MCP: intelligent search (server only) ---
# The Sanity Context MCP endpoint. Base form (no Context document yet):
#   https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>
# Once a sanity.agentContext document exists, append its slug: /<slug>
# Auth reuses SANITY_API_READ_TOKEN (Viewer role). Requires a deployed Studio.
# Dev only: if this is unset or the MCP call fails (e.g. Studio not deployed),
# /api/search serves results from a small built-in mock catalog and adds the
# response header `x-vertex-search-source: mock`, so the UI + Ollama can be
# tested before the Studio is live. Never happens when NODE_ENV=production.
SANITY_CONTEXT_MCP_URL=

# --- Intelligent search: LLM (server only, local Ollama) ---
# The /api/search route talks to a local Ollama server over its
# OpenAI-compatible API (Vercel AI SDK + @ai-sdk/openai provider, AGENTS §6).
# No API key needed. Start Ollama and `ollama pull qwen2.5-coder` first.
# Server only — never prefix with NEXT_PUBLIC_.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional; the SDK needs a non-empty string but Ollama ignores it.
OLLAMA_API_KEY=ollama
# Optional model override. Defaults to qwen2.5-coder.
OLLAMA_MODEL=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
